---
import Base from '../../layouts/Base.astro';
import { Content, getHeadings } from '../../content/mine-or-yours.md';
import '../../styles/research-essay.css';
import { writing } from '../../data/writing.js';

const title = 'Mine or Yours?';
const subtitle = 'Mind-Bridged Language Models Take Each Other’s Memories as Their Own';
const pageTitle = `${title} ${subtitle}`;
const description = 'Two copies of one language model, one reading the other’s memory: the reader takes its partner’s assignment as its own, and its reports mark nothing as foreign. In this model, what decided ownership was how the content arrived.';
const published = '2026-09-26';
const hidden = Boolean(writing.find((entry) => entry.href === '/writing/mine-or-yours/')?.hidden);
const headings = getHeadings().filter((h) => h.depth === 2);
const paper = '/papers/mine-or-yours.pdf';
const paperTitle = 'Mine or Yours? Mind-Bridged Language Models Take Each Other’s Memories as Their Own';
const code = 'https://github.com/BeibaiDraco/mind-connecting';
const bibtex = `@misc{xu2026mine,
  title  = {{Mine or Yours? Mind-Bridged Language Models Take
             Each Other's Memories as Their Own}},
  author = {Xu, Yunlong},
  year   = {2026},
  month  = sep,
  note   = {Preprint},
  url    = {https://dracoxu.com/papers/mine-or-yours.pdf}
}`;
---

<Base title={pageTitle} description={description} current="Writing" article={true} noindex={hidden}
  publishedTime={published} author="Draco (Yunlong) Xu" updated="September 26, 2026"
  socialImage={{
    src: '/images/writing/mine-or-yours/cover-v2.png',
    width: 2400,
    height: 1260,
    type: 'image/png',
    alt: 'Mine or Yours? Mind-Bridged Language Models Take Each Other’s Memories as Their Own. Two identical heads in profile drawn in blue lines, one in horizontal lines and one in diagonal lines, laid slightly over each other so that the lines cross where they overlap.',
  }}>
  <header class="bay essay-heading">
    <div class="wide">
      <p class="essay-eyebrow"><span class="seal" aria-hidden="true"></span><a href="/writing/">Writing</a> <span aria-hidden="true">/</span> Research</p>
      <h1>{title}</h1>
      <p class="essay-subtitle">{subtitle}</p>
      <p class="essay-author">Draco (Yunlong) Xu <span aria-hidden="true">·</span> University of Chicago</p>
      <p class="essay-meta"><time datetime={published}>September 26, 2026</time> <span aria-hidden="true">·</span> 15–20 min read</p>
      <p class="essay-paper-link"><a href={paper}>Read the paper (PDF draft)</a> <span aria-hidden="true">·</span> <a href={code}>Code and protocols</a></p>
    </div>
    <div class="horizon"></div>
  </header>

  <div class="bay">
    <div class="wide essay-layout">
      <article class="research-essay" aria-label={pageTitle}>
        <Content />
        <footer class="essay-paper">
          <p><a href={paper}><cite>{paperTitle}</cite> (PDF)</a></p>
          <p>Yunlong Xu · Preprint draft, September 2026. Code, frozen protocols and a map from every figure and table to the runs it was computed from: <a href={code}>github.com/BeibaiDraco/mind-connecting</a>.</p>
        </footer>
        <section class="essay-endmatter" aria-labelledby="endmatter-citation">
          <h2 class="endmatter-label" id="endmatter-citation">Citation</h2>
          <pre><code>{bibtex}</code></pre>
          <p class="endmatter-log">First published September 26, 2026.</p>
        </section>
      </article>
      {headings.length > 0 && <aside class="essay-contents">
        <nav aria-label="On this page">
          <p class="lbl">On this page</p>
          <ol>{headings.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      </aside>}
    </div>
  </div>
</Base>
