---
import example from '../data/scientific-worlds/module-example.json';
const { switchNumber, allOffReading: reference, switchOnReading: perturbed } = example;
const changedLight = Array.from(perturbed).findIndex((bit, i) => bit !== reference[i]);
const readings = [
  { label: 'All inputs off', bits: reference },
  { label: `Switch ${switchNumber} on`, bits: perturbed }
];
---
<figure class="lab" id="laboratory" data-lab data-switch-number={switchNumber} data-reference={reference} data-perturbed={perturbed} data-observed-index={changedLight} aria-labelledby="lab-title">
  <header class="lab-head">
    <h3 id="lab-title">Inside the model’s lab</h3>
    <div class="kit">
      <a href="#prompts">Starting instructions</a>
    </div>
  </header>
  <ol class="flow" role="list" aria-label="Experiments in the research lab">
    <li>
      <h4>Write Python</h4>
      <div class="instrument console">
        <div class="terminal-bar"><span aria-hidden="true">&gt;_</span> Lab console</div>
        <pre><code>x = [0] * 740
x[{switchNumber}] = <b data-code-bit>1</b>
act({`{"op":"observe", "x":x}`})</code></pre>
      </div>
    </li>
    <li>
      <h4>Flip switch {switchNumber}</h4>
      <div class="instrument switches" role="group" aria-label="Magnified view of three of the 720 switches">
        <span class="ellipsis" aria-hidden="true">…</span>
        <div class="control"><span>{switchNumber-1}</span><span class="track" aria-hidden="true"></span><span>Off</span></div>
        <button class="control active" type="button" role="switch" aria-label={`Switch ${switchNumber}`} aria-checked="true" data-lab-flip disabled>
          <span>{switchNumber}</span><span class="track" aria-hidden="true"></span><strong data-switch-state>On</strong>
        </button>
        <div class="control"><span>{switchNumber+1}</span><span class="track" aria-hidden="true"></span><span>Off</span></div>
        <span class="ellipsis" aria-hidden="true">…</span>
      </div>
      <p>All other inputs stay off.</p>
    </li>
    <li>
      <h4>Buy one reading</h4>
      <div class="instrument box">
        <svg viewBox="0 0 190 70" role="img" aria-label="720 switches and 20 auxiliary inputs enter the hidden circuit. The box returns 20 output bits.">
          <g fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M8 20h34l12 8h14M8 50h34l12-8h14M122 28h15l9-8h36M122 42h15l9 8h36"/>
            <rect x="68" y="10" width="54" height="50" stroke-dasharray="4 3"/>
          </g>
          <text x="95" y="46" text-anchor="middle">?</text>
        </svg>
        <span>720 switches + 20 extra controls</span>
      </div>
      <p>Cost per reading · 1 credit</p>
    </li>
    <li>
      <h4>Read 20 lights</h4>
      <div class="instrument meter">
        {readings.map(({label,bits}, row) => <div class="reading">
          <span class="reading-label" data-reading-label={row}>{label}</span>
          <span class="cells" role="img" aria-label={bits} data-observation={row}>
            {Array.from(bits,(bit,i) => <i class:list={[bit === '1' && 'on', row === 1 && i === changedLight && 'changed']}></i>)}
          </span>
        </div>)}
      </div>
      <p class="indicator"><i aria-hidden="true"></i><strong data-lamp>Light {changedLight+1} turns on.</strong></p>
    </li>
  </ol>
  <div class="loop"><span>Choose the next experiment</span></div>
  <span class="assist" role="status" data-lab-status></span>
</figure>

<script>
  const lab = document.querySelector<HTMLElement>('[data-lab]');
  if (lab) {
    const flip = lab.querySelector<HTMLButtonElement>('[data-lab-flip]')!;
    const reading = lab.querySelector<HTMLElement>('[data-observation="1"]')!;
    const light = Number(lab.dataset.observedIndex);
    flip.disabled = false;
    flip.addEventListener('click', () => {
      const on = flip.getAttribute('aria-checked') !== 'true';
      const bits = on ? lab.dataset.perturbed! : lab.dataset.reference!;
      flip.setAttribute('aria-checked', String(on));
      lab.toggleAttribute('data-off', !on);
      lab.querySelector('[data-code-bit]')!.textContent = on ? '1' : '0';
      lab.querySelector('[data-switch-state]')!.textContent = on ? 'On' : 'Off';
      const setting = `Switch ${lab.dataset.switchNumber} ${on ? 'on' : 'off'}`;
      lab.querySelector('[data-reading-label="1"]')!.textContent = setting;
      reading.setAttribute('aria-label', bits);
      Array.from(reading.children).forEach((cell, i) => {
        cell.classList.toggle('on', bits[i] === '1');
        cell.classList.toggle('changed', bits[i] !== lab.dataset.reference![i]);
      });
      const result = on ? `Light ${light + 1} turns on.` : `Light ${light + 1} is off.`;
      lab.querySelector('[data-lamp]')!.textContent = result;
      lab.querySelector('[data-lab-status]')!.textContent = `${setting}. ${result}`;
    });
  }
</script>
<style>
  .lab {container-type:inline-size;--gap:clamp(18px,2.5vw,38px);margin:28px 0;padding:16px 0;border-block:1px solid var(--kei);color:var(--contour);scroll-margin-top:20px}
  h3,h4,p,ol,pre,figcaption {margin:0}
  .lab-head,.kit {display:flex;align-items:baseline;flex-wrap:wrap}
  .lab-head {justify-content:space-between;gap:8px 20px}
  h3 {font:500 clamp(25px,3vw,32px)/1.15 var(--serif);letter-spacing:-.025em;color:var(--sumi)}
  .kit {gap:2px 16px;font:12px/1.5 var(--mono)}
  .flow {display:grid;grid-template-columns:1.15fr .85fr 1fr 1.18fr;gap:var(--gap);list-style:none;margin:22px 0 0;padding:0}
  .flow li {position:relative;min-width:0}
  .flow li+li::before {content:'→';position:absolute;top:70px;left:calc(-1 * var(--gap));width:var(--gap);text-align:center;font:22px/1 var(--serif)}
  h4 {font:500 22px/1.2 var(--serif);color:var(--sumi);letter-spacing:-.02em;margin-bottom:9px}
  .instrument {height:108px;box-sizing:border-box}
  .console {display:flex;flex-direction:column;justify-content:center;border:1px solid var(--sea);background:var(--shoal)}
  .terminal-bar,.control,.reading-label,.box span {font:12px/1.3 var(--mono)}
  .terminal-bar {display:flex;gap:9px;align-items:center;padding:0 10px 5px;border-bottom:1px solid var(--kei);color:var(--contour)}
  .terminal-bar span {font-weight:600}
  pre {padding:6px 10px 0;white-space:pre-wrap;overflow-wrap:anywhere;font:13px/1.4 var(--mono);color:var(--sumi)}
  pre code {font:inherit}pre b {color:var(--wave)}
  .switches {display:flex;align-items:center;justify-content:space-evenly;background:var(--shoal);border-block:1px solid var(--kei)}
  .ellipsis {color:var(--sea)}
  .control {display:grid;justify-items:center;align-content:center;gap:4px;color:var(--contour)}
  .track {display:block;position:relative;height:37px;width:15px;border:1px solid var(--sea);background:var(--paper)}
  .track::after {content:'';position:absolute;bottom:1px;left:1px;right:1px;height:12px;background:var(--sea)}
  .active {min-width:44px;min-height:86px;padding:3px 4px;border:1px solid var(--wave);color:var(--sumi);background:var(--paper);cursor:pointer}
  .active:hover,.active:focus-visible {outline:2px solid var(--wave);outline-offset:2px}
  .active[aria-checked=true] .track::after {bottom:auto;top:1px;background:var(--wave)}
  .box {display:grid;align-content:center;justify-items:center;gap:4px;border:1px dashed var(--contour)}
  .box svg {width:80%;height:66px;color:var(--contour)}.box text {fill:currentColor;font:32px var(--serif)}
  .box span {font-size:11px;text-align:center}
  .meter {display:grid;align-content:center;gap:10px}
  .reading {display:grid;gap:5px}
  .cells {display:grid;grid-template-columns:repeat(20,minmax(0,1fr));gap:2px}
  .cells i {aspect-ratio:1;border:1px solid var(--sea);background:var(--paper);position:relative}
  .cells .on,.indicator i {background:var(--wave);border-color:var(--wave)}
  .cells .changed::after {content:'';position:absolute;inset:auto -1px -4px;border-bottom:2px solid var(--sumi)}
  .flow p,figcaption {font:16px/1.35 var(--serif)}.flow p {margin-top:8px}
  .indicator {display:flex;align-items:center;gap:6px}
  .indicator i {width:12px;height:12px;border:1px solid var(--wave);border-radius:50%}
  [data-off] .indicator i {background:var(--paper)}
  .loop {margin:12px 10% 20px;height:16px;border:1px solid var(--wave);border-top:0;position:relative;text-align:center}
  .loop::before {content:'';position:absolute;top:1px;left:-4px;border-left:1px solid var(--wave);border-top:1px solid var(--wave);width:6px;height:6px;transform:rotate(45deg)}
  .loop span {position:relative;top:6px;padding:0 9px;background:var(--paper);font:italic 16px/1.3 var(--serif)}
  .assist {position:absolute;width:1px;height:1px;clip-path:inset(50%);overflow:hidden}
  @container(max-width:56rem) {
    .flow {grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 30px}
    .flow li:nth-child(3)::before {display:none}
    .loop {margin:14px 0 8px;height:auto;border:0;text-align:left}
    .loop::before {display:none}.loop span {top:0;padding:0}.loop span::before {content:'↺ ';font-style:normal}
  }
  @container(max-width:35rem) {
    .flow {grid-template-columns:1fr;gap:18px;margin-top:16px}
    .flow li {display:grid;grid-template-columns:minmax(90px,.85fr) minmax(0,1.85fr);gap:3px 12px;align-items:center}
    .flow li+li::before,.flow li:nth-child(3)::before {display:block;content:'↓';top:-17px;left:1px;width:auto;font-size:16px}
    h4 {font-size:19px;margin:0}.flow p {grid-column:2;margin:2px 0 0}
    .instrument {height:auto;min-height:78px}.console {padding:6px 0}
    .switches {padding:4px}.box {padding:4px}.box svg {height:38px}
    .meter {gap:8px}.kit {font-size:11px}
  }
  @container(max-width:20rem) {
    .flow li {grid-template-columns:1fr;gap:5px}
    .flow p {grid-column:1}
  }
</style>
