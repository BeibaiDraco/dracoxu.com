---
import { initialWindow, lightNumber, ports, readModule, signed, switchNumber, windows } from '../data/scientific-worlds/module-rule';
const corners = windows[initialWindow];
const baseline = readModule(false);
---
<figure id="hidden-modules" aria-labelledby="cutaway-title">
  <div class="overview">
    <div class="explanation">
      <h3 id="cutaway-title">Inside the hidden circuit</h3>
      <p>This box splits its 720 switches into <strong>30 hidden modules</strong>. Ten are 4×4 grids, ten are 4×6, and ten are 4×8.</p>
      <p>Within each 2×2 square, multiply the four switch values (+1 or −1). The module adds those products over every square, wrapping at the edges. That sum is its output.</p>
    </div>
    <div class="map">
      <div class="map-label">One 4×8 module <span>Switch numbers</span></div>
      <div class="board" role="img" data-board aria-label={`Four-by-eight grid. The highlighted square contains switches ${corners.map(i => ports[i]).join(', ')}.`}>
        {ports.map((port,i) => <span class:list={['cell', {selected:corners.includes(i)}]} data-cell>
          <span>{port}</span><b class="sign">{signed(baseline.signs[i])}</b>
        </span>)}
      </div>
      <div class="example"><span>Highlighted square</span><span class="equation" data-equation>{corners.map(i => signed(baseline.signs[i])).join(' × ')} = <b>{signed(baseline.products[initialWindow])}</b></span></div>
    </div>
  </div>
  <details>
    <summary>Explore the square rule</summary>
    <div class="workings">
      <div>
        <h4>One square</h4>
        <p>The wiring gives each switch setting its sign. Move the window one place to see which four switches contribute the next product.</p>
        <div class="controls"><button type="button" data-next disabled>Next square</button><span>Square <b data-index>{initialWindow + 1}</b> of {ports.length}</span></div>
      </div>
      <div>
        <h4>One light</h4>
        <p>Six weighted module outputs feed each light. This module feeds light {lightNumber} with a weight of −2. The remaining inputs add up to −5.</p>
        <div class="readout">Module output <b data-total>{signed(baseline.total)}</b><span aria-hidden="true">→</span> Light {lightNumber} <b data-light>off ({signed(baseline.lightSum)})</b></div>
        <div class="controls"><button type="button" role="switch" aria-checked="false" aria-label={`Flip switch ${switchNumber}`} data-flip disabled>Flip switch {switchNumber}</button><span>All other inputs stay off.</span></div>
      </div>
    </div>
    <span class="assist" data-status role="status"></span>
  </details>
</figure>
<script>
  import { initialWindow, lightNumber, ports, readModule, signed, windows } from '../data/scientific-worlds/module-rule';
  const figure = document.getElementById('hidden-modules')!;
  const details = figure.querySelector('details')!;
  const cells = figure.querySelectorAll<HTMLElement>('[data-cell]');
  const next = figure.querySelector<HTMLButtonElement>('[data-next]')!;
  const flip = figure.querySelector<HTMLButtonElement>('[data-flip]')!;
  let face = initialWindow;
  let on = false;

  function render() {
    const { signs, products, total, lightSum } = readModule(on);
    const corners = windows[face];
    cells.forEach((cell,i) => {
      cell.classList.toggle('selected', corners.includes(i));
      cell.querySelector('b')!.textContent = signed(signs[i]);
    });
    const names = corners.map(i => ports[i]).join(', ');
    figure.querySelector('[data-board]')!.setAttribute('aria-label', 'Four-by-eight grid. Highlighted switches: ' + names + '.');
    const equation = figure.querySelector('[data-equation]')!;
    const product = equation.querySelector('b')!;
    equation.replaceChildren(corners.map(i => signed(signs[i])).join(' × ') + ' = ', product);
    product.textContent = signed(products[face]);
    const lamp = (lightSum > 0 ? 'on' : 'off') + ' (' + signed(lightSum) + ')';
    figure.querySelector('[data-index]')!.textContent = String(face + 1);
    figure.querySelector('[data-total]')!.textContent = signed(total);
    figure.querySelector('[data-light]')!.textContent = lamp;
    flip.setAttribute('aria-checked', String(on));
    figure.querySelector('[data-status]')!.textContent = 'Switches ' + names + ' give ' + signed(products[face]) + '. Grid total ' + signed(total) + '. Light ' + lightNumber + ' ' + lamp + '.';
  }
  next.addEventListener('click', () => {
    face = (face + 1) % windows.length;
    render();
  });
  flip.addEventListener('click', () => { on = !on; render(); });
  details.addEventListener('toggle', () => {
    if (!details.open) { face = initialWindow; on = false; render(); }
  });
  next.disabled = flip.disabled = false;
</script>
<style>
  figure {container-type:inline-size;position:relative;color:var(--contour);border-block:1px solid var(--kei);margin:26px 0;padding:16px 0 11px;scroll-margin-top:20px}
  h3,h4,p {margin:0}
  .overview {display:grid;grid-template-columns:minmax(0,1.25fr) minmax(280px,1fr);align-items:center;gap:clamp(24px,5vw,78px)}
  h3 {font:500 clamp(25px,3vw,32px)/1.15 var(--serif);letter-spacing:-.025em;color:var(--sumi)}
  p {font:17px/1.38 var(--serif);margin-top:7px;max-width:52ch}
  .map-label,.controls,.readout,.equation,button,summary,.board {font-family:var(--mono)}
  .map-label {display:flex;justify-content:space-between;align-items:center;margin:0 0 4px;font-size:13px}
  .map-label span {color:var(--sea)}
  .board {display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:1px;background:var(--kei);border:1px solid var(--kei)}
  .cell {display:grid;place-items:center;padding:3px 0;background:var(--paper);color:var(--contour);font-size:13px;line-height:1.15}
  .cell.selected {background:var(--wave);color:var(--paper)}
  .sign {display:none}.overview:has(+ details[open]) .sign {display:block;font-size:15px}
  details {margin-top:7px}
  summary {width:fit-content;color:var(--wave);font-size:13px;cursor:pointer;padding:7px 2px}
  summary:hover {text-decoration:underline}
  .workings {display:grid;grid-template-columns:1fr 1fr;gap:22px 5%;background:var(--shoal);padding:15px 18px}
  h4 {font:500 21px/1.2 var(--serif);color:var(--sumi)}
  .workings p {font-size:16px}
  .example {display:flex;align-items:baseline;flex-wrap:wrap;gap:3px 12px;margin-top:5px;font:14px/1.3 var(--serif)}
  .equation {font-size:13px;color:var(--sumi);white-space:nowrap}
  .readout {font-size:15px;line-height:1.45;color:var(--sumi);margin:10px 0}
  .readout span {padding-inline:8px}
  .controls {display:flex;gap:8px 12px;align-items:center;flex-wrap:wrap;font-size:13px}
  .workings p + .controls {margin-top:10px}
  button {font-size:13px;border:1px solid var(--sea);border-radius:0;background:var(--paper);color:var(--sumi);padding:7px 10px;cursor:pointer}
  button[aria-checked=true] {background:var(--wave);color:var(--paper)}
  button:focus-visible,summary:focus-visible {outline:2px solid var(--wave);outline-offset:2px}
  .assist {position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
  @container (max-width:43rem) {
    .overview,.workings {grid-template-columns:1fr;gap:12px}
    .workings {gap:18px}.cell {padding:4px 0}
  }
</style>
