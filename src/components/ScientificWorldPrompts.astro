---
import n0 from '../data/scientific-worlds/prompts/neural-B-N0.txt?raw';
import m from '../data/scientific-worlds/prompts/neural-B-M.txt?raw';
import f from '../data/scientific-worlds/prompts/neural-B-F.txt?raw';

interface Props { release: string }
const { release } = Astro.props;
const cards = [
  {
    id: 'N0', title: 'How to use the box', prompt: n0,
    summary: 'The manual tells the model how to set the switches, read the lights and wire a controller. It knows what each measurement and each part will cost. It can flip switches one at a time or try several together and watch which lights change.'
  },
  {
    id: 'M', title: 'Look for groups of four', prompt: m,
    summary: 'Each light adds up the effects of groups of four switches. Flipping one switch can help turn a light on or off depending on its three partners. The model gets the rule for adding up those effects. Most groups contribute nothing. Experiments reveal which ones count and by how much.'
  },
  {
    id: 'F', title: 'The grids inside the box', prompt: f,
    summary: 'The 720 switches form 30 hidden grids. Ten are 4×4, ten are 4×6 and ten are 4×8. The four corners of each small square act together, and six grids feed each light. The model knows a working controller is within budget. The switch numbers are shuffled, so it still has to find which switch goes where.'
  }
];
---
<section class="prompt-section" id="prompts" aria-labelledby="prompt-title">
  <header class="intro">
    <h2 id="prompt-title">What the model is told</h2>
    <p>For the box shown above, all three versions start with the same operating manual.</p>
  </header>
  <div class="cards">
    {cards.map(({id,title,summary,prompt}) =>
      <section class="card" data-condition={id} aria-labelledby={`prompt-${id}`}>
        <h3 id={`prompt-${id}`}><b>{id}</b><span>{title}</span></h3>
        <p>{summary}</p>
        <details>
          <summary aria-label={`Read the full ${id} prompt`}>Read the full prompt</summary>
          <pre tabindex="0" aria-label={`Original ${id} prompt`}><code>{prompt}</code></pre>
          <a href={`${release}/benchmark/prompts/neural-B-${id}.txt`} aria-label={`Open the original ${id} prompt on GitHub`}>View on GitHub ↗</a>
        </details>
      </section>
    )}
  </div>
</section>
<style>
  .prompt-section {container-type:inline-size;margin:38px auto 24px;scroll-margin-top:20px}
  .intro {max-width:var(--reading-width);margin-inline:auto;color:var(--contour)}
  .intro h2 {margin:0 0 8px;font:450 clamp(29px,3vw,38px)/1.12 var(--serif);letter-spacing:-.025em;color:var(--sumi)}
  .intro p {margin:0;font:19px/1.44 var(--serif)}
  .cards {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:20px}
  .card {display:flex;flex-direction:column;min-width:0;border-block:1px solid var(--kei);background:var(--shoal);padding:17px 18px 12px}
  .cards:has(details[open]) {align-items:start}
  h3 {display:flex;align-items:baseline;gap:10px;margin:0;color:var(--sumi)}
  h3 b {color:var(--wave);font:600 17px/1.2 var(--mono)}
  h3 span {font:500 23px/1.15 var(--serif);letter-spacing:-.02em}
  .card p {margin:11px 0 15px;color:var(--contour);font:18px/1.42 var(--serif)}
  details {margin-top:auto;border-top:1px solid var(--kei);padding-top:6px}
  summary,.card a {color:var(--wave);font:12px/1.5 var(--mono)}
  summary {width:fit-content;max-width:100%;padding-block:6px;cursor:pointer}
  summary:hover {text-decoration:underline;text-underline-offset:3px}
  pre {max-height:21rem;margin:7px 0;padding:10px;background:var(--paper);color:var(--contour);overflow:auto;scrollbar-gutter:stable;white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.55 var(--mono)}
  code {font:inherit}
  summary:focus-visible,pre:focus-visible {outline:2px solid var(--wave);outline-offset:2px}
  @container(max-width:48rem) {
    .cards {grid-template-columns:1fr;gap:10px}
    .card {padding:14px 15px 9px}
    pre {max-height:16rem}
  }
</style>
