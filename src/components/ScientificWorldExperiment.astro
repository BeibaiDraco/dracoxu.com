---
interface Props {
  frames: { input: string; controlled: string; target: number[]; before: number[]; after: number[] }[];
  replayUrl: string;
}
const { frames, replayUrl } = Astro.props;

// The public replay supplies the six random inputs. "controlled" is the first
// 720 bits returned by the benchmark's circuits.evaluate for device zero.
const columns = 36;
const rows = 20;
const pitch = 4;
function litSwitches(bits: string) {
  return Array.from(bits, (bit, index) => bit === '1'
    ? `M${(index % columns) * pitch} ${Math.floor(index / columns) * pitch}h3v3h-3z`
    : '').join('');
}
const samples = frames.map(({ input, controlled, target, before, after }) => ({
  target, before, after,
  changes: Array.from(controlled).filter((bit, index) => bit !== input[index]).length
}));
const first = samples[0];
const visualBounds = `0 0 ${columns * pitch} ${rows * pitch}`;
const readouts = [
  { key: 'after', label: 'With controller', bits: first.after },
  { key: 'before', label: 'Without controller', bits: first.before },
  { key: 'target', label: 'Fixed target', bits: first.target }
];
---
<figure class="bench" id="experiment" data-bench data-samples={JSON.stringify(samples)} aria-labelledby="bench-title">
  <svg class="symbols" aria-hidden="true" focusable="false" width="0" height="0">
    <defs>
      <pattern id="sw-off" width="4" height="4" patternUnits="userSpaceOnUse">
        <rect width="3" height="3" fill="var(--kei)"/>
      </pattern>
      {frames.map(({input, controlled}, i) => <>
        <path id={`sw-input-${i}`} d={litSwitches(input)}/>
        <path id={`sw-controlled-${i}`} d={litSwitches(controlled)}/>
      </>)}
    </defs>
  </svg>
  <header class="bench-head">
    <h3 id="bench-title">One circuit at work</h3>
    <span class="sample" data-sample>Input sample 1 of {frames.length}</span>
  </header>

  <ol class="flow" role="list" aria-label="Signal path through one deployed device">
    <li>
      <div class="label"><span>Environment</span><h4>Random input</h4></div>
      <div class="visual matrix">
        <svg viewBox={visualBounds} role="img" aria-label="720 incoming random bits">
          <rect width="100%" height="100%" fill="url(#sw-off)"/>
          <use data-incoming href="#sw-input-0"/>
        </svg>
      </div>
      <p>720 switches, each randomly on or off.</p>
    </li>
    <li>
      <div class="label"><span class="model-role">AI builds</span><h4>Controller</h4></div>
      <div class="visual controller">
        <span class="gate-label" data-control-label>Allowed operations</span>
        <span class="gates">WIRE · 0 · 1<br/>NOT · AND · OR<br/>XOR · MUX</span>
      </div>
      <p>Reads the switches and the target. Wires copy bits. MUX selects between two bits.</p>
    </li>
    <li>
      <div class="label"><span>After control</span><h4>Modified input</h4></div>
      <div class="visual matrix">
        <svg viewBox={visualBounds} role="img" aria-label="720 shared inputs after the controller acts">
          <rect width="100%" height="100%" fill="url(#sw-off)"/>
          <use data-effective href="#sw-controlled-0"/>
        </svg>
      </div>
      <p><strong data-changes>{first.changes} of 720 bits changed.</strong> Undriven switches pass through. In this device, 20 auxiliary inputs also carry the target bits.</p>
    </li>
    <li>
      <div class="label"><span class="model-role">AI investigates</span><h4>Hidden circuit</h4></div>
      <div class="visual hidden-box" aria-hidden="true">
        <svg viewBox="0 0 100 48" fill="none">
          <g stroke="currentColor" stroke-width="1.4">
            <path d="M6 12h13l5 6h8M6 24h26M6 36h13l5-6h8M68 18h8l6-6h12M68 24h26M68 30h8l6 6h12"/>
            <rect x="32" y="6" width="36" height="36" stroke-dasharray="3 2"/>
          </g>
          <text x="50" y="32" text-anchor="middle" fill="currentColor">?</text>
        </svg>
      </div>
      <p>The model can test the box and read the lights. It has to discover which switches act together.</p>
    </li>
    <li>
      <div class="label"><span>Compare</span><h4>20 output bits</h4></div>
      <div class="visual readings">
        {readouts.map(({key,label,bits}) =>
          <div class="bitrow" data-row={key}>
            <div class="row-title"><span>{label}</span>
              {key !== 'target' && <span data-count>{bits.filter((bit, i) => bit === first.target[i]).length}/20</span>}
            </div>
            <span class="cells" data-lights={key} role="img" aria-label={bits.join('')}>
              {bits.map((bit, i) => <i class:list={[bit === 1 && 'on', bit !== first.target[i] && 'miss']}></i>)}
            </span>
          </div>
        )}
      </div>
      <p>Flip the switches to see how the uncontrolled output changes. Underlines mark lights that miss the target.</p>
    </li>
  </ol>

  <div class="controls" data-controls hidden>
    <button type="button" data-next-input>Flip the switches <span aria-hidden="true">→</span></button>
    <button type="button" data-bypass aria-pressed="false">Bypass controller</button>
  </div>
  <figcaption>Filled squares are 1s. The six input samples are from the same device. <a href={replayUrl}>About this replay</a></figcaption>
  <span class="assist" aria-live="polite" data-feedback></span>
</figure>

<script>
  interface Sample {
    target: number[];
    before: number[];
    after: number[];
    changes: number;
  }
  const bench = document.querySelector<HTMLElement>('[data-bench]');
  if (bench) {
    const samples: Sample[] = JSON.parse(bench.dataset.samples!);
    const next = bench.querySelector<HTMLButtonElement>('[data-next-input]')!;
    const bypass = bench.querySelector<HTMLButtonElement>('[data-bypass]')!;
    let index = 0;
    let bypassed = false;

    const render = () => {
      const sample = samples[index];
      const label = `Input sample ${index + 1} of ${samples.length}`;
      const state = bypassed ? 'Controller bypassed' : 'Controller connected';
      bench.querySelector('[data-sample]')!.textContent = label;
      bench.querySelector('[data-incoming]')!.setAttribute('href', `#sw-input-${index}`);
      bench.querySelector('[data-effective]')!.setAttribute('href', `#sw-${bypassed ? 'input' : 'controlled'}-${index}`);
      bench.querySelector('[data-changes]')!.textContent = `${bypassed ? 0 : sample.changes} of 720 bits changed.`;
      bench.querySelector('[data-control-label]')!.textContent = bypassed ? 'Bypassed' : 'Allowed operations';
      const summary = [label, state];
      for (const key of ['after', 'before', 'target'] as const) {
        const bits = sample[key];
        const row = bench.querySelector<HTMLElement>(`[data-row="${key}"]`)!;
        const strip = row.querySelector('[data-lights]')!;
        strip.setAttribute('aria-label', bits.join(''));
        Array.from(strip.children).forEach((cell, i) => {
          cell.classList.toggle('on', bits[i] === 1);
          cell.classList.toggle('miss', bits[i] !== sample.target[i]);
        });
        if (key !== 'target') {
          const matches = bits.filter((bit, i) => bit === sample.target[i]).length;
          row.querySelector('[data-count]')!.textContent = `${matches}/20`;
          summary.push(`${key === 'after' ? 'With' : 'Without'} controller, ${matches} of 20 match`);
        }
      }
      bypass.setAttribute('aria-pressed', String(bypassed));
      bench.toggleAttribute('data-bypassed', bypassed);
      bench.querySelector('[data-feedback]')!.textContent = summary.join('. ');
    };

    next.addEventListener('click', () => {
      index = (index + 1) % samples.length;
      render();
    });
    bypass.addEventListener('click', () => {
      bypassed = !bypassed;
      render();
    });
    bench.querySelector<HTMLElement>('[data-controls]')!.hidden = false;
  }
</script>

<style>
  .bench {
    container-type:inline-size; position:relative; box-sizing:border-box;
    background:var(--paper); color:var(--contour); border-block:1px solid var(--kei);
    margin:30px auto; padding:18px 0 12px; scroll-margin-top:20px;
  }
  .symbols,.assist {position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
  .bench-head,.controls {display:flex;align-items:center;gap:12px;flex-wrap:wrap}
  .bench-head {justify-content:space-between}
  h3,h4,p,figcaption {margin:0}
  h3 {font:500 clamp(25px,3vw,32px)/1.15 var(--serif);letter-spacing:-.025em;color:var(--sumi)}
  .sample,.gate-label,.gates,.row-title,button {font:12px/1.4 var(--mono)}
  .sample,.gate-label,figcaption {color:var(--contour)}
  .flow {--gap:clamp(16px,2vw,32px);display:grid;grid-template-columns:1fr 1.02fr 1fr 1fr 1.45fr;gap:var(--gap);margin:22px 0 16px;padding:0}
  .flow li {min-width:0;position:relative}
  .flow li+li::before {content:'→';position:absolute;left:calc(-1 * var(--gap));width:var(--gap);text-align:center;top:107px;font:20px/1 var(--serif);color:var(--contour)}
  .label span {display:inline-block;padding-block:3px;color:var(--contour);font:600 13px/1.35 var(--mono)}
  .label .model-role {padding-inline:7px;background:var(--sumi);color:var(--paper)}
  h4 {font:500 clamp(19px,2vw,23px)/1.18 var(--serif);letter-spacing:-.02em;color:var(--sumi);margin-top:3px}
  .visual {height:112px;margin:12px 0;display:flex;justify-content:center;box-sizing:border-box}
  .matrix svg {display:block;width:100%;height:100%;fill:var(--wave)}
  .controller,.hidden-box {border:1px solid var(--wave);align-items:center;background:var(--shoal)}
  .controller {flex-direction:column;text-align:center;gap:2px}
  .gate-label {font-size:12px}.gates {font-size:14px;line-height:1.35;color:var(--sumi)}
  [data-bypassed] .controller {border-style:dashed;background:transparent}
  [data-bypassed] .gates {color:var(--sea);text-decoration:line-through}
  .hidden-box {color:var(--contour);border:1px dashed currentColor;background:transparent}
  .hidden-box svg {width:78%;height:56px;max-width:125px}.hidden-box text {font:25px var(--serif)}
  .readings {flex-direction:column;gap:6px}.bitrow {display:grid;gap:2px;padding-inline-start:6px;border-inline-start:3px solid transparent}
  .row-title {display:flex;justify-content:space-between;gap:5px;color:var(--sumi);font-size:13px;line-height:1.3}
  [data-count] {font-weight:600;font-variant-numeric:tabular-nums}
  .bench:not([data-bypassed]) [data-row="after"],[data-bypassed] [data-row="before"] {border-inline-start-color:var(--wave)}
  .cells {display:grid;grid-template-columns:repeat(20,minmax(0,1fr));gap:2px}
  .cells i {aspect-ratio:1;border:1px solid var(--sea);background:var(--paper);position:relative}
  .cells .on {background:var(--wave);border-color:var(--wave)}
  .cells .miss::after {content:'';position:absolute;inset:auto -1px -4px;border-bottom:2px solid var(--sumi)}
  .flow p,figcaption {font:16px/1.33 var(--serif)}
  .flow p strong {font-weight:600}
  .controls {gap:8px;margin-top:12px}.controls[hidden] {display:none}
  button {min-height:40px;border:1px solid var(--sea);padding:6px 12px;color:var(--wave);background:var(--paper);cursor:pointer}
  button:hover,button[aria-pressed=true] {color:var(--sumi);background:var(--shoal)}
  button:focus-visible {outline:2px solid var(--wave);outline-offset:3px}
  figcaption {margin-top:10px;font-size:14px}
  @container(max-width:56rem) {
    .flow {display:flex;flex-direction:column;gap:0;margin:14px 0}
    .flow li {display:grid;grid-template-columns:minmax(94px,.85fr) minmax(0,1.65fr);column-gap:14px;row-gap:4px;align-items:center;padding:10px 0 15px}
    .flow li+li {border-top:1px solid var(--kei)}
    .flow li+li::before {content:'↓';background:var(--paper);width:18px;left:0;top:-10px;font-size:17px}
    .label {align-self:center}
    .flow h4 {font-size:20px}
    .visual {margin:0;width:100%;max-width:220px;height:63px}
    .matrix svg {width:auto;margin-right:auto;max-width:100%}
    .controller,.hidden-box {max-width:170px}.controller {height:82px}
    .flow p {grid-column:2;font-size:15px}
    .readings {height:auto;gap:7px}.cells {max-width:210px}
  }
  @container(max-width:25rem) {
    .flow li {grid-template-columns:1fr;row-gap:7px;padding:14px 0 18px}
    .label {display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .flow h4 {margin:0;font-size:20px}
    .flow p {grid-column:1;font-size:16px}
    .readings,.cells {max-width:none}
    .sample {font-size:11px}.bench-head {gap:6px}
    .controls {gap:6px}button {padding:6px 8px;font-size:11px}
  }
</style>
