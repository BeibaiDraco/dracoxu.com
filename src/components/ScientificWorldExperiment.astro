---
import frames from '../data/scientific-worlds/teaching-figure.json';
const first = frames[0];
const rows = [
  {key:'target',label:'Target',bits:first.target},
  {key:'before',label:'No controller',bits:first.before},
  {key:'after',label:'With controller',bits:first.after}
];
function inputPixels(bits: string) {
  return Array.from(bits, (bit,i) => bit === '1'
    ? `M${(i%60)*4} ${Math.floor(i/60)*4}h3v3h-3z` : '').join(' ');
}
---
<figure class="bench" id="experiment" data-bench data-frames={JSON.stringify(frames)}>
  <div class="bench-head"><h3>Try one device</h3><span data-sample>Input sample 1 of {frames.length}</span></div>
  <div class="instrument">
    <div class="field">
      <p>720 environmental inputs</p>
      <svg viewBox="0 0 240 48" role="img" aria-label="Binary state of the current 720 environmental inputs">
        <defs><pattern id="bit-base" width="4" height="4" patternUnits="userSpaceOnUse"><rect width="3" height="3" fill="var(--kei)"/></pattern></defs>
        <rect width="240" height="48" fill="url(#bit-base)"/><path data-inputs d={inputPixels(first.input)} fill="var(--wave)"/>
      </svg>
    </div>
    <div class="readout"><p>20 output bits</p>
      {rows.map(({key,label,bits}) => <div class="bitrow" data-row={key}>
        <span class="row-label">{label}</span>
        <span class="cells" role="img" aria-label={bits.join('')}>
          {bits.map((bit,i)=><i class:list={[bit===1 && 'on',key!=='target' && bit!==first.target[i] && 'miss']}></i>)}
        </span>
        <span class="count">{key==='target' ? 'Matches' : `${bits.filter((bit,i)=>bit===first.target[i]).length}/20`}</span>
      </div>)}
    </div>
  </div>
  <div class="bench-bottom"><figcaption>Each column is one bit. A mark beneath it shows a mismatch with the target. These six inputs come from the public teaching replay.</figcaption>
    <button type="button" data-next-input hidden>Change inputs <span aria-hidden="true">→</span></button></div>
  <span class="assist" aria-live="polite" data-feedback></span>
</figure>
<script>
  interface Frame {input:string;target:number[];before:number[];after:number[]}
  const bench = document.querySelector<HTMLElement>('[data-bench]');
  if (bench) {
    const frames: Frame[] = JSON.parse(bench.dataset.frames!);
    let current = 0;
    const next = bench.querySelector<HTMLButtonElement>('[data-next-input]')!;
    next.hidden = false;
    next.addEventListener('click', () => {
      current = (current + 1) % frames.length;
      const frame = frames[current];
      const sample = `Input sample ${current+1} of ${frames.length}`;
      bench.querySelector('[data-sample]')!.textContent = sample;
      bench.querySelector('[data-inputs]')!.setAttribute('d', Array.from(frame.input, (bit,i) =>
        bit === '1' ? `M${(i%60)*4} ${Math.floor(i/60)*4}h3v3h-3z` : '').join(' '));
      const summary = [sample];
      for (const key of ['target','before','after'] as const) {
        const row = bench.querySelector<HTMLElement>(`[data-row="${key}"]`)!;
        const bits = frame[key];
        const strip = row.querySelector('.cells')!;
        strip.setAttribute('aria-label',bits.join(''));
        Array.from(strip.children).forEach((cell,i) => {
          cell.classList.toggle('on',bits[i]===1);
          cell.classList.toggle('miss',key!=='target' && bits[i]!==frame.target[i]);
        });
        if (key !== 'target') {
          const matches = bits.filter((bit,i)=>bit===frame.target[i]).length;
          row.querySelector('.count')!.textContent = `${matches}/20`;
          summary.push(`${row.querySelector('.row-label')!.textContent}, ${matches} of 20 match`);
        }
      }
      bench.querySelector('[data-feedback]')!.textContent = summary.join('. ');
    });
  }
</script>
<style>
  .bench {margin:24px 0 0;background:var(--shoal);border:1px solid var(--kei);padding:20px 24px;scroll-margin-top:20px}
  .bench-head,.bench-bottom {display:flex;align-items:center;justify-content:space-between;gap:20px}
  .bench-head h3 {font:500 25px/1.15 var(--serif);margin:0;color:var(--sumi)}
  .bench-head span,.instrument p,.row-label,.count,.bench button {font:11px/1.4 var(--mono)}
  .bench-head span,.instrument p {color:var(--sea)}.bench-head{border-bottom:1px solid var(--kei);padding-bottom:13px}
  .instrument {display:grid;grid-template-columns:minmax(0,.72fr) minmax(0,1.28fr);gap:clamp(20px,4vw,50px);align-items:center;margin:20px 0 22px}
  .instrument p {margin:0 0 10px}.field svg {display:block;width:100%;height:auto}
  .bitrow {display:grid;grid-template-columns:96px minmax(0,1fr) 52px;gap:10px;align-items:center;margin:7px 0}
  .count {text-align:right;color:var(--contour)}[data-row=target] .count{font-size:10px;color:var(--sea)}
  .cells {display:grid;grid-template-columns:repeat(20,minmax(0,1fr));gap:2px}
  .cells i {display:block;aspect-ratio:1;max-height:15px;background:var(--paper);border:1px solid var(--sea);position:relative}
  .cells .on {background:var(--wave);border-color:var(--wave)}.miss::after {content:'';position:absolute;inset:auto -1px -4px;border-bottom:2px solid var(--contour)}
  [data-row=after] {margin-top:10px}.bench-bottom {border-top:1px solid var(--kei);padding-top:12px}
  figcaption {font:15px/1.4 var(--serif);color:var(--sea);max-width:65ch}
  button {border:1px solid var(--sea);background:var(--paper);color:var(--contour);min-height:44px;padding:8px 12px;white-space:nowrap;cursor:pointer}
  button:hover {border-color:var(--sumi);color:var(--sumi)}.assist {position:absolute;width:1px;height:1px;clip-path:inset(50%);overflow:hidden}
  @media(max-width:720px){.instrument{grid-template-columns:1fr;gap:18px}.field svg{max-width:300px}.bitrow{grid-template-columns:94px minmax(0,1fr) 48px}.bench{padding:16px}.bench-bottom{align-items:flex-start}.bench-head span{font-size:10px}}
  @media(max-width:480px){.bench-bottom{display:grid;gap:10px}.bench-bottom button{justify-self:start}.bitrow{grid-template-columns:80px minmax(0,1fr) 39px;gap:5px}.row-label,.count{font-size:10px}.cells{gap:1px}}
</style>
